{
  "name": "react-native-yet-another-sortable",
  "keywords": [
    "drag-drop",
    "scrollable",
    "draggable",
    "sortable",
    "grid",
    "list",
    "performance"
  ],
  "version": "1.0.0",
  "description": "Drag-and-drop sortable scrollable grid view for React Native.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "src",
    "index.d.ts"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --project tsconfig.json",
    "update-docs": "rimraf docs && npx typedoc && node updateDocs.js && rimraf docs",
    "test": "npm test --prefix example",
    "validate": "npm run typecheck && npm run lint && npm test",
    "package": "rimraf dist && mkdir dist && npm pack --pack-destination dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/k5md/react-native-yet-another-sortable.git"
  },
  "author": "k5md",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.11.1",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/runtime": "^7.11.2",
    "@react-native/babel-preset": "^0.85.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "babel-jest": "^26.2.2",
    "eslint": "^8.57.0",
    "react": "^19.2.3",
    "react-native": "^0.85.2",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/k5md/react-native-yet-another-sortable/issues"
  },
  "homepage": "https://github.com/k5md/react-native-yet-another-sortable#readme"
}
